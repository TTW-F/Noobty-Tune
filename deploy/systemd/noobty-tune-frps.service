# ============================================================
# frps 服务端守护 —— 运行于云服务器 106.14.175.93
# 部署位置:/etc/systemd/system/noobty-tune-frps.service
# 前提:frp 程序位于 /usr/local/bin/frps,配置位于
#       /etc/noobty-tune/frps.toml(参考 deploy/frp/frps.toml)
# ============================================================

[Unit]
Description=Noobty Tune FRP Server (cloud entry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=/usr/local/bin/frps -c /etc/noobty-tune/frps.toml
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
