# ============================================================
# 后端服务 —— 运行于内网后端机 192.168.31.35(不在云机上)
#
# 部署位置:/etc/systemd/system/noobty-tune-backend.service
# 工作目录:/srv/noobty-tune-backend
# 说明:只监听 127.0.0.1,对外统一走 frp 隧道 + 云机 nginx。
# ============================================================

[Unit]
Description=Noobty Tune Backend Service (LAN origin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=noobty
Group=noobty
WorkingDirectory=/srv/noobty-tune-backend
Environment=NODE_ENV=production
Environment=PORT=3101
ExecStartPre=/usr/bin/bash -lc '! /usr/bin/ss -lnt | /usr/bin/awk '"'"'{print $4}'"'"' | /usr/bin/grep -q ":${PORT}$"'
ExecStart=/usr/bin/bash -lc 'if [ -f package.json ]; then /usr/bin/npm ci --omit=dev && /usr/bin/npm run start; else /usr/bin/python3 /srv/noobty-tune-backend/backend_placeholder.py; fi'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
